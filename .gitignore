/vite
/sugar-scratchie@0.1.0

# Nested frontend repo (own git history: sugar-scratch-merged2)
frontend-new/

# Generated ControlNet frames and output
public/cards/controlnet-frames/
public/cards/controlnet-output/

# Self-hosted dotlottie WASM, copied from node_modules by `postinstall`
