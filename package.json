{
  "name": "sugar-scratchie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-dotlottie-wasm.mjs",
    "predev": "node scripts/copy-dotlottie-wasm.mjs",
    "dev": "vite",
    "dev:api": ".venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8090 --reload",
    "dev:all": "concurrently -k --kill-others-on-fail -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": ".venv/bin/alembic -c backend/alembic.ini upgrade head",
    "db:seed": ".venv/bin/python -m backend.db.seed",
    "stack": "bash scripts/manage.sh start",
    "stack:setup": "bash scripts/manage.sh setup",
    "stack:reset-db": "bash scripts/manage.sh reset-db",
    "stack:stop": "bash scripts/manage.sh stop",
    "stack:status": "bash scripts/manage.sh status",
    "manage": "bash scripts/manage.sh",
    "sync:player-scratch": "bash scripts/sync-player-scratch-shared.sh",
    "generate:mesh": "PYTORCH_ENABLE_MPS_FALLBACK=1 .venv/bin/python scripts/generate-mesh-tracking.py",
    "adjust:photo-match": ".venv/bin/python scripts/adjust_photo_match.py",
    "video-flow": ".venv/bin/python scripts/video-flow.py",
    "prebuild": "node scripts/copy-dotlottie-wasm.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "stress:symbols": "node scripts/stress-symbol-perf.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.8",
    "@lottiefiles/dotlottie-web": "^0.77.0",
    "@radix-ui/themes": "^3.3.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  }
}
