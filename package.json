{
  "name": "sugar-scratchie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": ".venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 8090 --reload --reload-exclude '.tmp/*' --reload-exclude 'public/*'",
    "dev:player": "npm --prefix frontend-new run dev",
    "dev:all": "concurrently -k --kill-others-on-fail -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "dev:lp": "concurrently -k --kill-others-on-fail -n api,web,player -c blue,green,magenta \"npm run dev:api\" \"npm run dev\" \"npm run dev:player\"",
    "generate:mesh": "PYTORCH_ENABLE_MPS_FALLBACK=1 .venv/bin/python scripts/generate-mesh-tracking.py",
    "adjust:photo-match": ".venv/bin/python scripts/adjust_photo_match.py",
    "video-flow": ".venv/bin/python scripts/video-flow.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:api": ".venv/bin/pytest tests/ -q",
    "perf:api": ".venv/bin/python scripts/perf-api-load.py",
    "test": "npm run build && npm run test:api",
    "postinstall": "node scripts/copy-dotlottie-wasm.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.19.8",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.3.0",
    "framer-motion": "^14.14.0",
    "goey-toast": "^0.6.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
